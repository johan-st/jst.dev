package web

templ stylesBase() {
<style type="text/css">
    :root {
        --clr-bg: #333;
        --clr-text: #ccc;
        --border-radius: 6px;
    }
</style>
}

templ stylesForm() {
<style type="text/css">
    .form-wrapper {
        padding: 20px;
        width: 100%;

    }

    form {
        display: flex;
        flex-direction: column;
        width: 100%;
        padding: 20px;
        gap: 10px;

        border: 1px solid #888;
        border-radius: 5px;
    }
</style>
}